<?xml version="1.0" encoding="utf-8"?>
<!--
  悠悠截图 (YoyoScreenshot) — MSIX 清单模板
  Identity.Name / Publisher 必须与 Partner Center 预留身份一致。
  PublisherDisplayName 必须与发布者显示名一致。
  签名证书 Subject 须与 Identity.Publisher 一致（本地测试证书已按此 CN 生成）。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="7395C427.3077793B6268F"
    Publisher="CN=0220A900-026B-463F-AEFE-0F5505669E86"
    Version="1.0.4.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>悠悠截图</DisplayName>
    <PublisherDisplayName>海边知心人</PublisherDisplayName>
    <Description>悠悠截图 — 区域/全屏截图工具</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-cn" />
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
      Id="YouYouJieTu"
      Executable="YoyoScreenshot.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="悠悠截图"
        Description="悠悠截图 — 区域/全屏截图工具"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
